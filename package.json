    "i18next-browser-languagedetector": "^8.2.3",
    "lucide-react": "^1.61.0",
    "motion": "14.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "svg-path-bbox": "^2.1.0",
